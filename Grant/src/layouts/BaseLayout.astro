---
/**
 * BaseLayout.astro
 * Shared layout for all pages - eliminates code duplication across HTML files.
 * 
 * ZERO-JS Architecture: This layout ships no JavaScript by default.
 * Pages can opt-in to inline scripts via <script is:inline> when needed.
 */
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Grant Palasak - Cybersecurity Student & Technology Enthusiast" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/favicon.png">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="bg-dark-bg text-gray-300 font-sans">
  <div class="flex flex-col min-h-screen">
    <header class="max-w-4xl mx-auto w-full p-6 md:p-8">
      <slot name="nav">
        <!-- Default nav can be overridden per-page if needed -->
        <nav class="flex justify-between items-center">
          <a href="/" class="text-xl font-bold text-white font-mono">Grant Palasak</a>
          <ul class="flex items-center space-x-6 md:space-x-8 text-gray-400 font-mono text-sm">
            <li>
              <a href="/" class:list={["nav-link border-b-2 pb-1", Astro.url.pathname === "/" ? "active border-cyan-400 text-cyan-400" : "border-transparent"]}>
                /home
              </a>
            </li>
            <li>
              <a href="/about" class:list={["nav-link border-b-2 pb-1", Astro.url.pathname === "/about" || Astro.url.pathname === "/about/" ? "active border-cyan-400 text-cyan-400" : "border-transparent"]}>
                /about
              </a>
            </li>
            <li>
              <a href="/projects" class:list={["nav-link border-b-2 pb-1", Astro.url.pathname === "/projects" || Astro.url.pathname === "/projects/" ? "active border-cyan-400 text-cyan-400" : "border-transparent"]}>
                /projects
              </a>
            </li>
            <li>
              <a href="/contact" class:list={["nav-link border-b-2 pb-1", Astro.url.pathname === "/contact" || Astro.url.pathname === "/contact/" ? "active border-cyan-400 text-cyan-400" : "border-transparent"]}>
                /contact
              </a>
            </li>
            <li>
              <a href="https://intel.palasak.com" target="_blank" class="hidden md:inline-block ml-2 px-3 py-1 border border-cyan-500/50 rounded text-cyan-400 text-xs font-mono hover:bg-cyan-900/50 hover:border-cyan-400 transition-all uppercase tracking-wider">
                View Threat DB
              </a>
            </li>
          </ul>
        </nav>
      </slot>
    </header>

    <main class="flex-grow max-w-4xl mx-auto p-6 md:p-12 w-full">
      <slot />
    </main>

    <footer class="text-center p-6 mt-12 border-t border-gray-800">
      <div class="max-w-4xl mx-auto flex justify-between items-center text-sm text-gray-500 font-mono">
        <span>v1.2</span>
        <span class="text-red-400">[!] This site is not in scope.</span>
      </div>
    </footer>
  </div>
</body>
</html>

<style is:global>
  /* Nav link hover effects */
  .nav-link {
    transition: color 0.3s, border-color 0.3s;
  }
  .nav-link:hover {
    color: #22d3ee;
  }
  
  /* Hero glow effect */
  .glow {
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.4), 0 0 20px rgba(34, 211, 238, 0.2);
  }
  
  /* Typing cursor */
  .typing-cursor {
    background-color: #22d3ee;
    width: 10px;
    animation: blink 1s step-end infinite;
  }
  
  /* Status badges for projects page */
  .status-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-weight: 500;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }
  .status-active { background-color: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
  .status-live { background-color: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3); }
  .status-experiment { background-color: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
  
  /* Tech tags */
  .tech-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    background-color: rgba(55, 65, 81, 0.5);
    color: #9ca3af;
  }
  
  /* Project card hover */
  .project-card {
    transition: border-color 0.3s ease;
  }
  .project-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
  }
  
  /* New badge with animation */
  .new-badge {
    font-size: 0.6rem;
    padding: 0.15rem 0.4rem;
    border-radius: 9999px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: rgba(251, 146, 60, 0.2);
    color: #fb923c;
    border: 1px solid rgba(251, 146, 60, 0.4);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  
  /* Hero badge with bounce */
  .hero-badge {
    position: absolute;
    top: -10px;
    right: -12px;
    font-size: 0.65rem;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: linear-gradient(135deg, #fb923c 0%, #f97316 100%);
    color: #0D1117;
    box-shadow: 0 2px 8px rgba(251, 146, 60, 0.5);
    animation: bounce-attention 2s ease-in-out infinite;
    z-index: 10;
  }
  
  /* Animations */
  @keyframes blink {
    from, to { background-color: transparent; }
    50% { background-color: #22d3ee; }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 4px rgba(251, 146, 60, 0.3); }
    50% { box-shadow: 0 0 8px rgba(251, 146, 60, 0.6); }
  }
  @keyframes bounce-attention {
    0%, 100% { transform: translateY(0) scale(1); }
    25% { transform: translateY(-4px) scale(1.05); }
    50% { transform: translateY(0) scale(1); }
    75% { transform: translateY(-2px) scale(1.02); }
  }
</style>
