---
// BaseLayout.astro - Shared layout for all pages
// ZERO-JS Architecture: Ships no JavaScript by default. Pages opt-in via inline scripts.
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Grant Palasak - Junior Penetration Testing Engineer focused on offensive security, tooling, and homelab infrastructure" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/favicon.png">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-[#0f1110] text-[#d8d2c4] font-sans antialiased">
  <div class="site-shell flex flex-col min-h-screen">
    <header class="site-header max-w-6xl mx-auto w-full px-5 py-5 md:px-8 md:py-7">
      <slot name="nav">
        <!-- Default nav can be overridden per-page if needed -->
        <nav class="flex flex-col gap-4 border-b border-[#2b2f2b] pb-5 sm:flex-row sm:items-center sm:justify-between">
          <a href="/index.html" class="text-sm font-semibold uppercase tracking-[0.22em] text-[#f2eadc]">Grant Palasak</a>
          <ul class="flex flex-wrap items-center gap-4 text-xs uppercase tracking-[0.18em] text-[#8f948b] md:gap-6">
            <li>
              <a href="/index.html" class:list={["nav-link", Astro.url.pathname === "/" || Astro.url.pathname === "/index.html" ? "active" : ""]}>
                Home
              </a>
            </li>
            <li>
              <a href="/about" class:list={["nav-link", Astro.url.pathname === "/about" || Astro.url.pathname === "/about/" ? "active" : ""]}>
                About
              </a>
            </li>
            <li>
              <a href="/projects" class:list={["nav-link", Astro.url.pathname === "/projects" || Astro.url.pathname === "/projects/" ? "active" : ""]}>
                Projects
              </a>
            </li>
            <li>
              <a href="/contact" class:list={["nav-link", Astro.url.pathname === "/contact" || Astro.url.pathname === "/contact/" ? "active" : ""]}>
                Contact
              </a>
            </li>
            <li>
              <a href="https://intel.palasak.com" target="_blank" rel="noopener noreferrer" class="nav-link">
                Threat DB
              </a>
            </li>
          </ul>
        </nav>
      </slot>
    </header>

    <main class="flex-grow w-full">
      <slot />
    </main>

    <footer class="px-5 py-8 md:px-8">
      <div class="max-w-6xl mx-auto flex flex-col gap-3 border-t border-[#2b2f2b] pt-6 text-xs uppercase tracking-[0.18em] text-[#74796f] sm:flex-row sm:items-center sm:justify-between">
        <span>Grant Palasak v1.4</span>
        <span>Personal site, not an engagement target</span>
      </div>
    </footer>
  </div>
</body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background:
      radial-gradient(circle at top left, rgba(181, 146, 91, 0.12), transparent 34rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 12px),
      #0f1110;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(255,255,255,0.035), transparent 18%, transparent 82%, rgba(255,255,255,0.025));
    opacity: 0.45;
  }

  ::selection {
    background: rgba(194, 160, 104, 0.35);
    color: #fff7ea;
  }

  .nav-link {
    color: inherit;
    transition: color 180ms ease;
  }

  .nav-link:hover {
    color: #f2eadc;
  }

  .nav-link.active {
    color: #c9a66b;
  }

  .site-header nav {
    position: relative;
  }

  .site-header nav::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 5.5rem;
    height: 1px;
    background: #c9a66b;
  }

  .eyebrow {
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a8a395;
  }

  .text-accent {
    color: #c9a66b;
  }

  .rule {
    border-color: #2b2f2b;
  }

  .status-badge {
    border: 1px solid rgba(201, 166, 107, 0.28);
    border-radius: 9999px;
    color: #c9a66b;
    font-family: "Fira Code", monospace;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    text-transform: uppercase;
  }

  .tech-tag {
    color: #8f948b;
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
  }

  .quiet-link {
    color: #d8d2c4;
    text-decoration: underline;
    text-decoration-color: rgba(201, 166, 107, 0.35);
    text-underline-offset: 0.24em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .quiet-link:hover {
    color: #fff7ea;
    text-decoration-color: rgba(201, 166, 107, 0.85);
  }

  .reveal {
    animation: reveal-up 700ms ease both;
  }

  .reveal-delay {
    animation-delay: 120ms;
  }

  .reveal-delay-2 {
    animation-delay: 220ms;
  }

  .console-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  .console-kicker {
    color: #a8a395;
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .console-page-heading {
    margin: 0;
    color: #f4eddf;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
  }

  .console-intro {
    max-width: 43rem;
    color: #989d91;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .console-link {
    color: #f4eddf;
    font-family: "Fira Code", monospace;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .console-link::after {
    content: " →";
    color: #c9a66b;
  }

  .console-link:hover {
    color: #c9a66b;
  }

  .console-rule {
    border-color: #2b2f2b;
  }

  .console-row {
    display: grid;
    gap: 0.75rem;
    padding: 1.4rem 0;
    border-top: 1px solid #2b2f2b;
    color: #f4eddf;
    text-decoration: none;
    transition: background 180ms ease, padding 180ms ease;
  }

  .console-row:hover {
    background: rgba(201, 166, 107, 0.045);
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .console-row__index,
  .console-row__meta {
    color: #8f948b;
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .console-row__title {
    font-family: "Fira Code", monospace;
    font-size: 1rem;
    font-weight: 500;
  }

  .console-row__description {
    color: #989d91;
    line-height: 1.7;
  }

  .console-status {
    color: #c9a66b;
    font-family: "Fira Code", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .console-list {
    border-bottom: 1px solid #2b2f2b;
  }

  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }

  @media (max-width: 640px) {
    body {
      background:
        radial-gradient(circle at top left, rgba(181, 146, 91, 0.11), transparent 24rem),
        #0f1110;
    }

    .console-page {
      padding-top: 2rem;
    }
  }

  @media (min-width: 768px) {
    .console-page {
      padding: 4rem 2rem 6rem;
    }

    .console-row {
      grid-template-columns: 4rem minmax(10rem, 0.7fr) minmax(0, 1.4fr) auto;
      align-items: baseline;
      gap: 1.5rem;
    }
  }
</style>
