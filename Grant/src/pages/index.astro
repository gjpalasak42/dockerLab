---
// Home page - field notes / personal lab direction
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Home">
  <section class="hero-console">
    <div class="hero-console__inner">
      <div class="reveal">
        <p class="console-kicker mb-5">Junior Penetration Testing Engineer</p>
        <h1>Grant<br>Palasak</h1>
        <p class="hero-console__summary">Tools and systems that hold up in practice.</p>
        <p class="hero-console__detail">Security tooling, homelab infrastructure, and practical offensive security work.</p>
        <a href="/projects" class="console-link mt-8 inline-block">Explore selected work</a>
      </div>
      <aside class="hero-console__state reveal reveal-delay" aria-label="Current work">
        <div class="hero-console__state-head">
          <span>Now building</span>
          <span>03 active</span>
        </div>
        <ol>
          <li><b>01</b><a href="https://github.com/gjpalasak42/projectKepler" target="_blank" rel="noopener noreferrer">projectKepler</a><span>collaborative testing tooling</span></li>
          <li><b>02</b><a href="https://github.com/gjpalasak42/dockerLab" target="_blank" rel="noopener noreferrer">dockerLab</a><span>secure home infrastructure</span></li>
          <li><b>03</b><a href="https://intel.palasak.com" target="_blank" rel="noopener noreferrer">threat-tracker</a><span>intelligence interface research</span></li>
        </ol>
      </aside>
    </div>
  </section>

  <div class="console-page">
    <section class="reveal reveal-delay">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="console-kicker mb-3">Selected work</p>
          <h2 class="text-3xl font-semibold tracking-[-0.03em] text-[#f4eddf] md:text-4xl">Current projects and experiments.</h2>
        </div>
        <a href="/projects" class="console-link">All projects</a>
      </div>
      <div class="console-list">
        <a href="https://github.com/gjpalasak42/projectKepler" target="_blank" rel="noopener noreferrer" class="console-row"><span class="console-row__index">01</span><span class="console-row__title">projectKepler</span><span class="console-row__description">Burp Suite tooling for collaborative penetration testing.</span><span class="console-status">Active tooling</span></a>
        <a href="https://github.com/gjpalasak42/dockerLab" target="_blank" rel="noopener noreferrer" class="console-row"><span class="console-row__index">02</span><span class="console-row__title">dockerLab</span><span class="console-row__description">The homelab stack that hosts this site.</span><span class="console-status">Live infrastructure</span></a>
        <a href="https://rocks.palasak.com" target="_blank" rel="noopener noreferrer" class="console-row"><span class="console-row__index">03</span><span class="console-row__title">Rock Atlas</span><span class="console-row__description">An interactive geology explorer with searchable specimen data and field notes.</span><span class="console-status">Live project</span></a>
      </div>
    </section>

    <section class="mt-24 grid gap-8 border-t console-rule pt-10 md:grid-cols-[0.35fr_1fr]">
      <p class="console-kicker">Working notes</p>
      <p class="max-w-3xl text-2xl leading-snug text-[#f0e6d4] md:text-4xl">This site collects the public parts of my work: security tools, homelab infrastructure, frontend experiments, and ways to connect.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero-console {
    width: 100%;
    min-height: calc(100svh - 7rem);
    display: grid;
    align-items: center;
    border-bottom: 1px solid #2b2f2b;
    background: linear-gradient(90deg, rgba(201, 166, 107, 0.07), transparent 38%), rgba(15, 17, 16, 0.64);
  }

  .hero-console__inner {
    width: min(72rem, 100%);
    margin: 0 auto;
    display: grid;
    gap: 3rem;
    padding: 3rem 1.25rem;
  }

  .hero-console h1 {
    margin: 0;
    color: #f4eddf;
    font-size: clamp(4.5rem, 13vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.78;
  }

  .hero-console__summary {
    max-width: 42rem;
    margin: 2.5rem 0 0;
    color: #d8d2c4;
    font-size: clamp(1.55rem, 3vw, 2.7rem);
    line-height: 1.15;
  }

  .hero-console__detail {
    max-width: 37rem;
    margin: 1.25rem 0 0;
    color: #989d91;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hero-console__state {
    border-left: 1px solid #3b403a;
    padding-left: 1.5rem;
  }

  .hero-console__state-head,
  .hero-console__state li {
    display: grid;
    gap: 0.5rem;
  }

  .hero-console__state-head {
    grid-template-columns: 1fr auto;
    padding-bottom: 0.9rem;
    color: #a8a395;
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-console__state ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-console__state li {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    padding: 1rem 0;
    border-top: 1px solid #2b2f2b;
  }

  .hero-console__state b,
  .hero-console__state span {
    color: #8f948b;
    font-family: "Fira Code", monospace;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-console__state a {
    color: #f4eddf;
    font-family: "Fira Code", monospace;
    text-decoration: none;
  }

  .hero-console__state a:hover {
    color: #c9a66b;
  }

  .hero-console__state span {
    grid-column: 2;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .hero-console__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.55fr);
      align-items: end;
      gap: 5rem;
      padding: 5rem 2rem;
    }
  }
</style>
