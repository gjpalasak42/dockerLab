---
// Home page - field notes / personal lab direction
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Home">
  <section class="grid min-h-[64svh] items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="reveal max-w-3xl">
      <p class="eyebrow mb-5">Junior Penetration Testing Engineer</p>
      <h1 class="max-w-4xl text-5xl font-semibold leading-[0.96] tracking-[-0.03em] text-[#f4eddf] md:text-7xl lg:text-8xl">
        Grant Palasak
      </h1>
      <p class="mt-7 max-w-2xl text-2xl leading-snug text-[#cfc7b8] md:text-3xl">
        Security tooling, homelab infrastructure, and practical offensive security work.
      </p>
      <p class="mt-6 max-w-2xl text-base leading-8 text-[#989d91] md:text-lg">
        I hold a Bachelor of Science in Computer Science from Tennessee Technological University, with a concentration in Information Assurance and Cybersecurity. This site collects projects, experiments, and ways to connect.
      </p>
      <div class="mt-9 flex flex-wrap gap-4 text-sm font-medium">
        <a href="/projects" class="rounded-full bg-[#d7b46f] px-5 py-3 text-[#14140f] transition hover:bg-[#f0ce88]">
          View projects
        </a>
        <a href="https://github.com/gjpalasak42" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#3b403a] px-5 py-3 text-[#f4eddf] transition hover:border-[#c9a66b]">
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/grant-palasak-605b491aa/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#3b403a] px-5 py-3 text-[#f4eddf] transition hover:border-[#c9a66b]">
          LinkedIn
        </a>
      </div>
    </div>

    <svg class="lab-map reveal reveal-delay" viewBox="0 0 640 440" role="img" aria-labelledby="lab-map-title">
      <title id="lab-map-title">Public lab map</title>
      <defs>
        <pattern id="lab-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(255,255,255,0.035)" stroke-width="1" />
        </pattern>
        <radialGradient id="grid-fade" cx="50%" cy="50%" r="72%">
          <stop offset="0%" stop-color="white" stop-opacity="1" />
          <stop offset="100%" stop-color="white" stop-opacity="0" />
        </radialGradient>
        <mask id="grid-mask">
          <rect width="640" height="440" fill="url(#grid-fade)" />
        </mask>
      </defs>
      <rect class="lab-map__frame" x="0.5" y="0.5" width="639" height="439" />
      <rect width="640" height="440" fill="url(#lab-grid)" mask="url(#grid-mask)" />

      <a href="/">
        <g class="lab-node">
          <rect x="64" y="72" width="180" height="82" />
          <text x="86" y="105" class="lab-node__title">SITE</text>
          <text x="86" y="132" class="lab-node__meta">personal site</text>
        </g>
      </a>

      <a href="https://github.com/gjpalasak42" target="_blank" rel="noopener noreferrer">
        <g class="lab-node">
          <rect x="408" y="112" width="168" height="82" />
          <text x="430" y="145" class="lab-node__title">GITHUB</text>
          <text x="430" y="172" class="lab-node__meta">tools</text>
        </g>
      </a>

      <a href="https://intel.palasak.com" target="_blank" rel="noopener noreferrer">
        <g class="lab-node">
          <rect x="96" y="286" width="184" height="84" />
          <text x="118" y="322" class="lab-node__title">THREAT DB</text>
          <text x="118" y="350" class="lab-node__meta">osint</text>
        </g>
      </a>

      <a href="https://rocks.palasak.com" target="_blank" rel="noopener noreferrer">
        <g class="lab-node">
          <rect x="228" y="190" width="200" height="84" />
          <text x="250" y="226" class="lab-node__title">ROCK ATLAS</text>
          <text x="250" y="254" class="lab-node__meta">geology app</text>
        </g>
      </a>

      <a href="/projects">
        <g class="lab-node">
          <rect x="380" y="300" width="184" height="84" />
          <text x="402" y="336" class="lab-node__title">HOMELAB</text>
          <text x="402" y="364" class="lab-node__meta">infrastructure</text>
        </g>
      </a>

      <g class="lab-map__lines">
        <path d="M244 113 H328 V190" />
        <path d="M408 153 H328 V190" />
        <path d="M328 274 V342 H380" />
        <path d="M228 232 H188 V286" />
      </g>

      <g class="lab-map__ports" aria-hidden="true">
        <circle cx="244" cy="113" r="5" />
        <circle cx="408" cy="153" r="5" />
        <circle cx="328" cy="190" r="5" />
        <circle cx="328" cy="274" r="5" />
        <circle cx="380" cy="342" r="5" />
        <circle cx="188" cy="286" r="5" />
        <circle cx="228" cy="232" r="5" />
      </g>
    </svg>
  </section>

  <section class="mt-20 border-t border-[#2b2f2b] pt-10">
    <div class="grid gap-8 md:grid-cols-[0.4fr_1fr]">
      <p class="eyebrow">Currently</p>
      <div class="divide-y divide-[#2b2f2b]">
        <a href="https://github.com/gjpalasak42/projectKepler" target="_blank" rel="noopener noreferrer" class="home-row group">
          <span>projectKepler</span>
          <em>Burp Suite tooling for collaborative penetration testing.</em>
        </a>
        <a href="https://github.com/gjpalasak42/dockerLab" target="_blank" rel="noopener noreferrer" class="home-row group">
          <span>dockerLab</span>
          <em>The homelab stack that hosts this site.</em>
        </a>
        <a href="https://intel.palasak.com" target="_blank" rel="noopener noreferrer" class="home-row group">
          <span>threat-tracker</span>
          <em>A threat intelligence UI experiment.</em>
        </a>
        <a href="https://rocks.palasak.com" target="_blank" rel="noopener noreferrer" class="home-row group">
          <span>Rock Atlas</span>
          <em>An interactive geology explorer with searchable specimen data and field notes.</em>
        </a>
        <a href="/about" class="home-row group">
          <span>CPTS / PNPT</span>
          <em>Certifications and practical training in progress.</em>
        </a>
      </div>
    </div>
  </section>

  <section class="mt-20 grid gap-8 border-t border-[#2b2f2b] pt-10 md:grid-cols-[0.4fr_1fr]">
    <p class="eyebrow">Note</p>
    <p class="max-w-3xl text-2xl leading-snug text-[#f0e6d4] md:text-4xl">
      This site collects the public parts of my work: security tools, homelab infrastructure, frontend experiments, and contact links.
    </p>
  </section>
</BaseLayout>

<style>
  .lab-map {
    display: block;
    width: 100%;
    aspect-ratio: 640 / 440;
    background: rgba(13, 15, 14, 0.64);
  }

  .lab-map__frame {
    fill: transparent;
    stroke: #2b2f2b;
    stroke-width: 1;
  }

  .lab-map__lines path {
    fill: none;
    stroke: #62675d;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .lab-map__ports circle {
    fill: #d7b46f;
    stroke: #111411;
    stroke-width: 1.5;
  }

  .lab-map a {
    text-decoration: none;
  }

  .lab-node {
    transition: transform 180ms ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .lab-node rect {
    fill: #111411;
    stroke: #3b403a;
    stroke-width: 1.5;
    transition: fill 180ms ease, stroke 180ms ease;
  }

  .lab-node__title {
    fill: #f4eddf;
    font-family: "Fira Code", monospace;
    font-size: 18px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .lab-node__meta {
    fill: #8f948b;
    font-size: 18px;
  }

  .lab-node:hover {
    transform: translateY(-3px);
  }

  .lab-node:hover rect {
    fill: #171914;
    stroke: #c9a66b;
  }

  .home-row {
    display: grid;
    gap: 0.75rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  .home-row span {
    color: #f4eddf;
    font-family: "Fira Code", monospace;
    font-size: 0.92rem;
  }

  .home-row em {
    color: #8f948b;
    font-style: normal;
    line-height: 1.7;
    transition: color 180ms ease;
  }

  .home-row:hover em {
    color: #cfc7b8;
  }

  @media (min-width: 768px) {
    .home-row {
      grid-template-columns: 12rem 1fr;
    }
  }

  @media (max-width: 640px) {
    .lab-node__title,
    .lab-node__meta {
      font-size: 17px;
    }
  }
</style>
