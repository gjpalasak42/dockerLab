---
// Home page - includes typing animation via inline script (zero-bundle overhead)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Home">
  <div class="flex items-center h-full">
    <div class="text-center md:text-left">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-2 glow font-mono">
        <span id="typing-text"></span><span class="typing-cursor">&nbsp;</span>
      </h1>
      <p class="text-lg text-cyan-400 font-mono mb-8">Cybersecurity Student & Technology Enthusiast</p>
      <p class="text-base md:text-lg leading-relaxed max-w-2xl mb-10">
        Welcome to my digital space. I'm a computer science student with a deep focus on offensive security. This site serves as a portfolio for my projects, a summary of my skills, and a point of contact.
      </p>
      <div class="relative inline-block">
        <a href="/projects" class="inline-block bg-cyan-500 text-gray-900 font-bold py-3 px-8 rounded-lg hover:bg-cyan-400 transition-colors duration-300 font-mono">
          View Projects & Competitions
        </a>
        <span class="hero-badge">New</span>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Typing animation - kept as inline script for zero-bundle overhead -->
<script is:inline>
  const typingTextElement = document.getElementById('typing-text');
  const textToType = "Grant Palasak.";
  let i = 0;
  function typeWriter() {
    if (i < textToType.length) {
      typingTextElement.innerHTML += textToType.charAt(i);
      i++;
      setTimeout(typeWriter, 150);
    }
  }
  document.addEventListener('DOMContentLoaded', typeWriter);
</script>
