---
/**
 * contact.astro - Contact page
 * 
 * ZERO-JS: This page ships no JavaScript - pure static content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Contact" description="Contact Grant Palasak - Open to connecting with peers, mentors, and fellow enthusiasts in the cybersecurity community.">
  <div class="flex items-center justify-center h-full">
    <div class="text-center bg-gray-800/50 border border-gray-700 rounded-lg p-8 md:p-12">
      <h1 class="text-3xl font-bold text-white mb-4 font-mono">Get In Touch</h1>
      <p class="text-gray-400 mb-6 max-w-md">
        I'm always open to connecting with peers, mentors, and fellow enthusiasts in the cybersecurity community. The best way to reach me is through LinkedIn.
      </p>
      <div class="space-y-4">
        <a 
          href="https://www.linkedin.com/in/grant-palasak-605b491aa/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-block bg-cyan-500 text-gray-900 font-bold py-3 px-8 rounded-lg hover:bg-cyan-400 transition-colors duration-300 font-mono"
        >
          [ LinkedIn ]
        </a>
        <p class="text-sm text-gray-500">
          Professional Inquiries: <a href="mailto:grant@palasak.com" class="text-cyan-400 hover:underline">grant@palasak.com</a>
          <br>
          Site Issues: <a href="mailto:support@palasak.com" class="text-cyan-400 hover:underline">support@palasak.com</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
