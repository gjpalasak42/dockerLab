---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | About" description="About Grant Palasak - Junior Penetration Testing Engineer with a B.S. in Computer Science and a concentration in Information Assurance and Cybersecurity.">
  <div class="console-page">
    <section class="reveal">
      <p class="console-kicker mb-5">Profile</p>
      <h1 class="console-page-heading">Security work with<br>practical range.</h1>
      <p class="console-intro mt-7">I am a Junior Penetration Testing Engineer with a Bachelor of Science in Computer Science from Tennessee Technological University, where I concentrated in Information Assurance and Cybersecurity. My work focuses on offensive security methodology, web and network assessments, tool development, and practical infrastructure.</p>
    </section>

    <section class="mt-20 grid gap-8 border-t console-rule pt-10 md:grid-cols-[0.35fr_1fr] reveal reveal-delay">
      <p class="console-kicker">Availability</p>
      <p class="max-w-3xl text-2xl leading-snug text-[#f0e6d4]">Not currently seeking new employment opportunities. Always open to connecting with people doing thoughtful work in technology and security.</p>
    </section>

    <section class="mt-20 reveal reveal-delay-2">
      <div class="mb-8">
        <p class="console-kicker mb-3">Capabilities</p>
        <h2 class="text-3xl font-semibold tracking-[-0.03em] text-[#f4eddf]">Technical focus.</h2>
      </div>
      <div class="console-list">
        <div class="console-row"><span class="console-row__index">01</span><span class="console-row__title">Offensive security</span><span class="console-row__description">Web and network assessments, basic Android testing, GenAI system evaluations, and custom tool development.</span><span class="console-status">Assess</span></div>
        <div class="console-row"><span class="console-row__index">02</span><span class="console-row__title">Languages & tools</span><span class="console-row__description">Python, Java, C++, Bash, Burp Suite API, React Native, and Power Automate.</span><span class="console-status">Build</span></div>
        <div class="console-row"><span class="console-row__index">03</span><span class="console-row__title">Development & ops</span><span class="console-row__description">Software development, DevSecOps principles, Agile/Scrum workflows, Docker, and containerization.</span><span class="console-status">Operate</span></div>
      </div>
    </section>
  </div>
</BaseLayout>
