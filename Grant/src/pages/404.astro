---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Not Found" description="The requested page could not be found.">
  <div class="console-page error-page">
    <section class="reveal">
      <p class="console-kicker mb-5">Error 404</p>
      <h1 class="console-page-heading">Signal lost.</h1>
      <p class="console-intro mt-7">The requested page is not part of the current site map. Return home or continue to the project index.</p>
    </section>

    <nav class="error-routes mt-20 border-y console-rule reveal reveal-delay" aria-label="Recovery routes">
      <a href="/index.html" class="error-route"><span>Home</span><small>Return to root →</small></a>
      <a href="/projects/" class="error-route"><span>Projects</span><small>Browse selected work →</small></a>
    </nav>
  </div>
</BaseLayout>

<style>
  .error-page {
    padding-top: clamp(4rem, 12vw, 9rem);
  }

  .error-routes {
    max-width: 52rem;
  }

  .error-route {
    display: grid;
    gap: 0.7rem;
    padding: 1.5rem 0;
    color: #f4eddf;
    font-family: "Fira Code", monospace;
    font-size: 1rem;
    text-decoration: none;
    transition: color 180ms ease, padding 180ms ease;
  }

  .error-route + .error-route {
    border-top: 1px solid #2b2f2b;
  }

  .error-route small {
    color: #8f948b;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .error-route:hover {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    color: #c9a66b;
  }

  @media (min-width: 640px) {
    .error-route {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
</style>
