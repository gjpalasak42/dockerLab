---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grant Palasak | Not Found" description="The requested page could not be found.">
  <div class="flex items-center justify-center h-full">
    <div class="text-center bg-gray-800/50 border border-gray-700 rounded-lg p-8 md:p-12">
      <p class="text-cyan-400 font-mono text-sm mb-3">404</p>
      <h1 class="text-3xl font-bold text-white mb-4 font-mono">Page Not Found</h1>
      <p class="text-gray-400 mb-6 max-w-md">
        The page you requested is not available. Return home or check the project index for the current site structure.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="inline-block bg-cyan-500 text-gray-900 font-bold py-3 px-8 rounded-lg hover:bg-cyan-400 transition-colors duration-300 font-mono">
          [ Home ]
        </a>
        <a href="/projects/" class="inline-block border border-cyan-500 text-cyan-400 font-bold py-3 px-8 rounded-lg hover:bg-cyan-900/40 transition-colors duration-300 font-mono">
          [ Projects ]
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
