---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    number: '01',
    name: 'projectKepler',
    status: 'Active tooling',
    description: 'Burp Suite tooling that reduces documentation debt and keeps collaborative penetration testing handoffs clear.',
    stack: 'Java 17 · Burp Extender API · JSON Persistence',
    href: 'https://github.com/gjpalasak42/projectKepler',
  },
  {
    number: '02',
    name: 'dockerLab',
    status: 'Live infrastructure',
    description: 'Security-first homelab orchestration. The public site is built with Astro for zero-JS static generation and deployed to Cloudflare Pages, while the Docker/Bun path remains available on localhost as a backup.',
    stack: 'Docker · Astro · Bun · Cloudflare Zero Trust',
    href: 'https://github.com/gjpalasak42/dockerLab',
  },
  {
    number: '03',
    name: 'threat-tracker',
    status: 'UI experiment',
    description: 'A threat intelligence UI experiment that pairs OSINT lookups with real-time data streaming and schema management.',
    stack: 'Next.js 16 · TypeScript · Drizzle ORM',
    href: 'https://intel.palasak.com',
  },
];
---

<BaseLayout title="Grant Palasak | Projects" description="Portfolio of security-focused projects including Burp Suite extensions, homelab infrastructure, and UI/UX experiments by Grant Palasak.">
  <div class="console-page">
    <section class="reveal">
      <p class="console-kicker mb-5">Selected work</p>
      <h1 class="console-page-heading">Projects built for<br>real use.</h1>
      <p class="console-intro mt-7">Security tools, infrastructure, and interface experiments—with the context needed to understand the work, not just the stack.</p>
    </section>

    <section class="mt-16 reveal reveal-delay" aria-label="Projects">
      <div class="mb-4 grid gap-3 border-b console-rule pb-4 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[#8f948b] md:grid-cols-[4rem_minmax(10rem,0.7fr)_minmax(0,1.4fr)_auto] md:gap-6">
        <span>Ref</span><span>Project</span><span>Purpose</span><span>State</span>
      </div>
      <div class="console-list">
        {projects.map((project) => (
          <a href={project.href} target="_blank" rel="noopener noreferrer" class="console-row">
            <span class="console-row__index">{project.number}</span>
            <span class="console-row__title">{project.name}</span>
            <span class="console-row__description">{project.description}<small>{project.stack}</small></span>
            <span class="console-status">{project.status}</span>
          </a>
        ))}

        <!-- Rock Atlas -->
        <a href="https://rocks.palasak.com" target="_blank" rel="noopener noreferrer" class="console-row">
          <span class="console-row__index">04</span>
          <span class="console-row__title">Rock Atlas</span>
          <span class="console-row__description">An interactive geology explorer with searchable specimen data, field notes, confidence scoring, favorites, and a lightweight quiz mode.<small>HTML · CSS · JavaScript · nginx · Docker</small></span>
          <span class="console-status"><span class="new-badge">New</span> Live project</span>
        </a>
      </div>
    </section>

    <!-- Certifications -->
    <section class="mt-24 grid gap-8 border-t console-rule pt-10 md:grid-cols-[0.35fr_1fr]">
      <p class="console-kicker">Training</p>
      <div>
        <h2 class="text-3xl font-semibold tracking-[-0.03em] text-[#f4eddf]">Practical security training.</h2>
        <div class="console-list mt-8">
          <div class="console-row"><span class="console-row__index">01</span><span class="console-row__title">Hack The Box CWES</span><span class="console-row__description">Preparing for the Certified Web Exploitation Specialist certification.</span><span class="console-status">In progress</span></div>
          <a href="https://certified.tcm-sec.com/embed/f0d3b6a4-ea35-4166-9df4-3892a5a5ed22" target="_blank" rel="noopener noreferrer" class="console-row certification-row" aria-label="View Grant Palasak's verified PNPT credential">
            <span class="console-row__index">02</span>
            <span class="console-row__title">TCM Security PNPT</span>
            <span class="console-row__description">Practical Network Penetration Tester.</span>
            <span class="certification-proof">
              <img src="https://api.accredible.com/v1/frontend/credential_website_embed_image/badge/189943032" alt="TCM Security Practical Network Penetration Tester badge" width="96" height="96" loading="lazy" decoding="async" />
              <span class="credential-status">
                <time class="console-status" datetime="2026-07-28">Passed July 28, 2026</time>
                <span class="credential-link-hint">View credential ↗</span>
              </span>
            </span>
          </a>
          <div class="console-row"><span class="console-row__index">03</span><span class="console-row__title">CPTC</span><span class="console-row__description">Former Team Captain for Tennessee Tech's CyberEagles. 1st Place Central Region (2024); 3rd Place Central Region (2025).</span><span class="console-status">Competition</span></div>
        </div>
      </div>
    </section>

    <section class="mt-20 border-t console-rule pt-8">
      <p class="console-kicker mb-3">Development workflow</p>
      <p class="console-intro">These projects are developed with an agentic workflow, primarily using Codex for planning, implementation, review, and iteration. I keep the technical decisions, security judgment, and final review in human hands.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .console-row small {
    display: block;
    margin-top: 0.55rem;
    color: #74796f;
    font-family: "Fira Code", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .new-badge {
    color: #f4eddf;
  }

  .certification-proof {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .certification-proof img {
    flex: 0 0 auto;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
  }

  .credential-status {
    display: grid;
    gap: 0.35rem;
  }

  .credential-link-hint {
    color: #74796f;
    font-family: "Fira Code", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .certification-row {
      align-items: center;
    }

    .certification-proof {
      justify-content: flex-end;
    }
  }
</style>
